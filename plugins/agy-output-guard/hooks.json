{
  "output-flood-guard": {
    "PostToolUse": [
      {
        "matcher": "run_command|read_file|view_file|grep_search|find_by_name|list_dir|edit_file|write_file|mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/output-guard-hook.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
